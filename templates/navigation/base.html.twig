{% if login_form is not defined %}
    {% block background %}
        <div class="background">
            <div class="shape"></div>
            <div class="shape"></div>
        </div>
    {% endblock %}

    <div class="navigation" >
        <div class="icon" >
            <svg fill="#fff" version="1.1" width="50%" height="100%" viewBox="0 0 24.75 24.75" xml:space="preserve" >
                <path d="M0,3.875c0-1.104,0.896-2,2-2h20.75c1.104,0,2,0.896,2,2s-0.896,2-2,2H2C0.896,5.875,0,4.979,0,3.875z M22.75,10.375H2
                    c-1.104,0-2,0.896-2,2c0,1.104,0.896,2,2,2h20.75c1.104,0,2-0.896,2-2C24.75,11.271,23.855,10.375,22.75,10.375z M22.75,18.875H2
                    c-1.104,0-2,0.896-2,2s0.896,2,2,2h20.75c1.104,0,2-0.896,2-2S23.855,18.875,22.75,18.875z"/>
            </svg>
        </div>

        {% if app.user %}
            <div class="user_info">
                <label>Zalogowany jako:</label>
                <div class="login">{{ app.user.login }}</div>
            </div>
        {% endif %}

        {% if is_granted(enum('App\\Model\\RoleEnum').Admin.value) %}
            {% include 'navigation/admin_login.html.twig' %}
        {% elseif is_granted(enum('App\\Model\\RoleEnum').User.value) %}
            {% include 'navigation/login.html.twig' %}
        {% else %}
            {% include 'navigation/logout.html.twig' %}
        {% endif %}
    </div>

    <div class="title">
        I T - G O O D N E S S - R A N K
    </div>
{% endif %}