{% extends 'template_base.html.twig' %}

{% block body %}
    {{ form_start(form, { 'attr': {'id': 'goodness_form', 'novalidate': 'novalidate'}}) }}

        <div class="row my-5 mx-1">
            
            <div class="col-12 mb-2">
                <h2>Edytuj pozycje</h2>
            </div>
        
            {% include "goodness/_form.html.twig" %}

            <div class="col-12 d-flex justify-content-start mt-3">
                {{ form_row(form.save, {
                    'label': 'Zapisz',
                    'attr': {
                        'class': 'btn btn-primary'
                    }
                }) }}

                <a class="confirm_delete mx-3" href="{{ path("delete_goodness", {id: form.vars.data.id}) }}">
                    <button class="btn btn-danger">USUŃ</button>
                </a>
            </div>
        </div>

    {{ form_end(form) }}
{% endblock %}